{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "instagram-viral-kit/output-schema.json",
  "title": "Instagram Viral Kit Output",
  "description": "Formatul structurat așteptat de la skills/reel-builder.md, skills/post-builder.md și skills/growth-doctor.md. Orice consumator automat al kitului validează outputul contra acestei scheme.",
  "type": "object",
  "required": ["kit", "brief_ref"],
  "properties": {
    "kit": {
      "type": "string",
      "const": "instagram-viral-kit",
      "description": "Identificatorul kitului — obligatoriu în orice output."
    },
    "kit_version": { "type": "string", "examples": ["1.0.0"] },
    "brief_ref": {
      "type": "string",
      "description": "Numele/calea fișierului de brief completat din care s-a generat."
    },
    "language": { "type": "string", "default": "ro" },
    "generated_at": { "type": "string", "format": "date-time" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Goluri din brief marcate NEVOIE_RESEARCH, fraze inventate, cifre de verificat, ținte 'heuristica kitului'."
    },
    "reels": {
      "type": "array",
      "description": "Reels complete (reel-builder).",
      "items": { "$ref": "#/definitions/reel" }
    },
    "posts": {
      "type": "array",
      "description": "Postări: carusele, foto, text (post-builder).",
      "items": { "$ref": "#/definitions/post" }
    },
    "account_setup": {
      "type": "array",
      "description": "Rezultatul auditului de setup (growth-doctor, Mod setup).",
      "items": { "$ref": "#/definitions/setup_check" }
    },
    "growth_plan": {
      "type": "object",
      "description": "Planul de 30 de zile (growth-doctor, Mod plan).",
      "$ref": "#/definitions/growth_plan"
    },
    "diagnostics": {
      "type": "array",
      "description": "Diagnosticul post-publicare (growth-doctor, Mod diagnostic).",
      "items": { "$ref": "#/definitions/diagnostic" }
    },
    "cross_channel": {
      "type": "array",
      "description": "Variante native TikTok / YouTube Shorts (short-video-adapter) sau intrări ale unui pachet multi-canal.",
      "items": { "$ref": "#/definitions/cross_channel_variant" }
    },
    "audit": { "$ref": "#/definitions/audit_summary" }
  },
  "definitions": {
    "cross_channel_variant": {
      "type": "object",
      "required": ["id", "platform", "base_id", "adaptations", "audit"],
      "properties": {
        "id": { "type": "string", "examples": ["TT1", "SH1"] },
        "platform": {
          "type": "string",
          "enum": ["tiktok", "youtube_shorts"],
          "description": "Destinația variantei (ghid §15)."
        },
        "base_id": {
          "type": "string",
          "description": "Id-ul Reel-ului de bază — ADN-ul (structura hook-ului, pilonul, promisiunea) rămâne cel al bazei."
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 180,
          "description": "TikTok: țintă 21–34s; Shorts: 20–60s (max 3 min)."
        },
        "hook_verbal": {
          "type": "string",
          "maxLength": 120,
          "description": "Hook-ul rostit adaptat (5–8 cuvinte; 4–6 pentru DE — ghid §16)."
        },
        "hook_verbal_word_count": { "type": "integer", "minimum": 2, "maximum": 12 },
        "text_on_screen": {
          "type": "string",
          "maxLength": 30,
          "description": "1–3 cuvinte de impact."
        },
        "master_clean": {
          "type": "boolean",
          "description": "true doar dacă master-ul e exportat curat, fără watermark (P0 altfel)."
        },
        "adaptations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Adaptările native față de bază: lungime, SEO, sunet/trend, CTA, titlu."
        },
        "caption_or_title": {
          "type": "object",
          "description": "TikTok: caption cu keyword. Shorts: titlul YouTube + descriere.",
          "properties": {
            "caption": { "type": "string" },
            "youtube_title": {
              "type": "string",
              "maxLength": 100,
              "description": "Titlul YouTube pentru Shorts — ≤60 caractere recomandat, keyword în față."
            },
            "description": { "type": "string" },
            "hashtags": { "type": "array", "maxItems": 5, "items": { "type": "string" } }
          }
        },
        "audit": { "$ref": "#/definitions/variant_audit" }
      }
    },
    "reel": {
      "type": "object",
      "required": ["id", "structure", "pillar", "goal", "hook", "script", "caption", "publish", "audit"],
      "properties": {
        "id": { "type": "string", "examples": ["R1"] },
        "title": { "type": "string", "description": "Titlul de lucru al Reel-ului." },
        "structure": {
          "type": "string",
          "enum": ["desire_based_past", "desire_based_future", "desire_based_direct", "negative_warning", "curiosity_gap", "pattern_interrupt", "contrarian", "number_led_proof", "audience_callout", "story_open", "industry_shock"],
          "description": "Structura de hook din ghid §6."
        },
        "pillar": { "type": "string", "description": "Content pillar-ul din brief în care se încadrează." },
        "goal": {
          "type": "string",
          "enum": ["reach", "saves_authority", "leads_comment_to_dm", "brand_personal"],
          "description": "Scopul declarat (din brief.goal)."
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 180,
          "description": "Durata totală în secunde (sweet spot 2026: 30–60)."
        },
        "hook": {
          "type": "object",
          "description": "Primele 3 secunde — 4 straturi sincronizate pe aceeași idee.",
          "required": ["visual", "verbal", "text_on_screen", "audio"],
          "properties": {
            "visual": { "type": "string", "description": "Cadrul secundei 0–3 (mid-motion, recuzită, unghi)." },
            "verbal": {
              "type": "string",
              "maxLength": 120,
              "description": "Replica rostită — 5–8 cuvinte (Regula 5-8-5), nivel clasa a 5-a."
            },
            "verbal_word_count": {
              "type": "integer",
              "minimum": 3,
              "maximum": 12,
              "description": "Numărul real de cuvinte din verbal (țintă 5–8)."
            },
            "text_on_screen": {
              "type": "string",
              "maxLength": 30,
              "description": "1–3 cuvinte de impact, mare, contrastant, în safe zone."
            },
            "audio": { "type": "string", "description": "Pattern interrupt: efect, pauză, schimbare de ritm." },
            "mute_test_passed": { "type": "boolean", "description": "true doar dacă vizual + text-on-screen transmit ideea fără sunet." }
          }
        },
        "script": {
          "type": "string",
          "description": "Script cu timecodes și Attention Resets marcate la fiecare 2–3,5s."
        },
        "editing_checklist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Checklistul de editare aplicat (dead air, subtitrări, mixaj, safe zones, cover)."
        },
        "caption": {
          "type": "object",
          "required": ["hook_line", "body", "cta", "hashtags"],
          "properties": {
            "hook_line": {
              "type": "string",
              "maxLength": 150,
              "description": "Linia 1–2 vizibilă în feed — buget ~125 caractere; keyword-ul subiectului prezent."
            },
            "visible_char_count": {
              "type": "integer",
              "maximum": 150,
              "description": "Caracterele reale ale hook_line (țintă ≤125)."
            },
            "body": { "type": "string", "description": "Valoare + întrebări + keyword natural." },
            "cta": {
              "type": "object",
              "required": ["value_exchange"],
              "properties": {
                "value_exchange": { "type": "string", "description": "ex: 'Comentează KIT și primești ghidul în DM'." },
                "keyword": { "type": "string", "description": "Cuvântul-cheie pentru Comment-to-DM (dacă ManyChat e activ)." },
                "layers": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 3,
                  "items": { "type": "string", "enum": ["text_on_screen", "verbal_end", "caption"] }
                }
              }
            },
            "hashtags": {
              "type": "array",
              "minItems": 0,
              "maxItems": 5,
              "items": { "type": "string" },
              "description": "3–5 hashtag-uri relevante; max oficial ~5."
            }
          }
        },
        "publish": {
          "type": "object",
          "required": ["channel", "quality_check"],
          "properties": {
            "channel": {
              "type": "string",
              "enum": ["trial_reels", "normal"],
              "description": "trial_reels pentru formate experimentale (test pe non-followeri, insights ~24h); normal pentru formate validate."
            },
            "timing_note": { "type": "string", "description": "Ora din Insights / baseline mar–mie 9–11." },
            "quality_check": { "type": "boolean", "description": "Upload at highest quality = ON." },
            "first_hour_action": { "type": "string", "description": "Ex: 'răspunzi la primele comentarii'." }
          }
        },
        "audit": { "$ref": "#/definitions/variant_audit" },
        "needs_research": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Câmpuri marcate NEVOIE_RESEARCH în acest livrabil."
        }
      }
    },
    "post": {
      "type": "object",
      "required": ["id", "format", "pillar", "caption"],
      "description": "'content' e obligatoriu doar la text_post/photo; caruselul obligă 'slides' (allOf if/then de mai jos).",
      "allOf": [
        {
          "if": { "required": ["format"], "properties": { "format": { "enum": ["text_post", "photo"] } } },
          "then": { "required": ["content"] }
        },
        {
          "if": { "required": ["format"], "properties": { "format": { "enum": ["carousel"] } } },
          "then": { "required": ["slides"] }
        }
      ],
      "properties": {
        "id": { "type": "string", "examples": ["P1"] },
        "title": { "type": "string" },
        "format": {
          "type": "string",
          "enum": ["carousel", "photo", "text_post", "story_series"],
          "description": "Formatul livrat."
        },
        "pillar": { "type": "string" },
        "hook_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": ["poza", "ceva_familiar", "contrastul", "intrebarile", "setarea_scenei", "stirea"]
          },
          "description": "Pentru text/foto: tipurile de hook text folosite (ghid §8.4)."
        },
        "slides": {
          "type": "array",
          "description": "Pentru carusele: slide-uri în ordine.",
          "items": {
            "type": "object",
            "required": ["position", "text"],
            "properties": {
              "position": { "type": "integer", "minimum": 1, "maximum": 20 },
              "text": { "type": "string", "description": "Textul slide-ului (≤25 cuvinte recomandat)." },
              "design_note": { "type": "string", "description": "Direcția vizuală a slide-ului." },
              "is_reference_slide": { "type": "boolean", "description": "Slide-ul de revenit — motorul de saves." }
            }
          }
        },
        "content": {
          "type": "string",
          "description": "Pentru text/foto: textul complet (hook-uri în primele paragrafe, întrebări pe tot textul, detalii concrete, opinie, open loop)."
        },
        "open_loop": { "type": "string", "description": "Subiectul deschis pentru seria următoare, dacă există." },
        "caption": {
          "type": "object",
          "required": ["hook_line", "body", "cta", "hashtags"],
          "properties": {
            "hook_line": { "type": "string", "maxLength": 150 },
            "visible_char_count": { "type": "integer", "maximum": 150 },
            "body": { "type": "string" },
            "cta": {
              "type": "object",
              "required": ["value_exchange"],
              "properties": {
                "value_exchange": { "type": "string" },
                "keyword": { "type": "string" },
                "save_prompt": { "type": "string", "description": "Ex: 'Salvează pentru luni' — motorul de saves la carusele." }
              }
            },
            "hashtags": { "type": "array", "maxItems": 5, "items": { "type": "string" } }
          }
        },
        "audit": { "$ref": "#/definitions/variant_audit" }
      }
    },
    "setup_check": {
      "type": "object",
      "required": ["item", "status"],
      "properties": {
        "item": {
          "type": "string",
          "enum": ["professional_account", "upload_highest_quality", "search_engine_indexing", "account_status", "translations", "bio_seo", "niche_clarity"],
          "description": "Cele 7 puncte din ghid §3."
        },
        "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "how_to_fix": { "type": "string", "description": "Pentru FAIL: unde se află setarea + ce să bifeze." },
        "is_blocker": { "type": "boolean", "description": "account_status FAIL = blocant P0." }
      }
    },
    "growth_plan": {
      "type": "object",
      "required": ["weeks"],
      "properties": {
        "strategy_name": { "type": "string", "examples": ["Best of Nine — 30 zile"] },
        "niche": { "type": "string" },
        "content_pillars": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
        "weeks": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["week", "theme", "actions", "success_metric"],
            "properties": {
              "week": { "type": "integer", "minimum": 1, "maximum": 4 },
              "theme": { "type": "string", "description": "ex: 'Setare & Cercetare'" },
              "actions": { "type": "array", "items": { "type": "string" } },
              "success_metric": { "type": "string", "description": "Obiectiv măsurabil al săptămânii." }
            }
          }
        },
        "month_success_metric": { "type": "string", "description": "ex: 'un Reel în valul 2+ de distribuție (majoritate non-followeri)'." }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["metric", "actual", "target", "diagnosis", "action"],
      "properties": {
        "metric": {
          "type": "string",
          "description": "ex: hook_rate_3s, completion_rate, sends_per_views, saves_per_views, comments_per_1k, follower_share_of_views"
        },
        "actual": { "type": "string", "description": "Valoarea reală din Insights raportată de utilizator." },
        "target": { "type": "string", "description": "Ținta din ghid §2.2 (cu marcaj 'heuristica kitului' unde e cazul)." },
        "diagnosis": { "type": "string" },
        "action": {
          "type": "string",
          "enum": ["hook_swap", "rewrite_opening", "edit_pacing", "cta_identity", "reference_slide", "points_gaps", "fix_niche", "run_setup_audit", "none_within_target"],
          "description": "Acțiunea tactică aleasă (ghid §11)."
        },
        "new_hooks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Pentru hook_swap: hook-urile noi generate."
        }
      }
    },
    "variant_audit": {
      "type": "object",
      "required": ["total", "verdict"],
      "properties": {
        "hook_scroll_stop": { "type": "integer", "minimum": 0, "maximum": 25 },
        "retention_structure": { "type": "integer", "minimum": 0, "maximum": 20 },
        "discoverability": { "type": "integer", "minimum": 0, "maximum": 20 },
        "compliance_originality": { "type": "integer", "minimum": 0, "maximum": 15 },
        "cta_growth_loop": { "type": "integer", "minimum": 0, "maximum": 20 },
        "total": { "type": "integer", "minimum": 0, "maximum": 100 },
        "verdict": { "type": "string", "enum": ["PASS", "REVISE", "REJECT"] },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
              "criterion": { "type": "string" },
              "problem": { "type": "string" },
              "fix": { "type": "string" }
            }
          }
        }
      }
    },
    "audit_summary": {
      "type": "object",
      "properties": {
        "auditor": { "type": "string", "const": "viral-auditor" },
        "total_score_avg": { "type": "number" },
        "pass_count": { "type": "integer" },
        "revise_count": { "type": "integer" },
        "reject_count": { "type": "integer" },
        "common_issues": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
